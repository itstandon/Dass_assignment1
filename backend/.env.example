# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/felicity_ems
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/felicity_ems

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Port
PORT=5000

# Email Service Configuration [Section 9.5]
# Option 1: Gmail SMTP
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Option 2: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# Option 3: Custom SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Email Sender Details
EMAIL_FROM_NAME=Felicity Event Management
EMAIL_FROM_ADDRESS=noreply@felicity.iiit.ac.in

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
